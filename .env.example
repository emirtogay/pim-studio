# Copy to .env.local and adjust. With DEMO_MODE=1 nothing below the demo section is needed:
# every external system (PIM API, asset portal, FTP photo server, storefronts) is replaced by a mock
# that serves the made-up "Northwind Apparel" catalogue.

# ── Demo ───────────────────────────────────────────────────────────
DEMO_MODE=1

# ── App ────────────────────────────────────────────────────────────
# SQLite by default; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://pim:<password>@localhost:5432/pim_studio
DATABASE_URL=sqlite:///./pim_studio.db
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SCHEDULER_ENABLED=false
UPLOADS_ROOT=./data/uploads
LOGS_ROOT=./logs

# ── PIM API (ignored in demo mode) ─────────────────────────────────
OMNITRON_BASE_URL=https://pim.example.test
OMNITRON_USERNAME=
OMNITRON_PASSWORD=
OMNITRON_WRITES_ENABLED=false
OMNITRON_TAKEDOWN_ENABLED=false

# ── Asset portal (ignored in demo mode) ────────────────────────────
BRAND_LIBRARY_DOMAIN=assets.example.test
BRAND_LIBRARY_CLIENT_ID=
BRAND_LIBRARY_CLIENT_SECRET=

# ── FTP photo server (ignored in demo mode) ────────────────────────
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_BASE_URL=https://images.example.test/pim-studio/
